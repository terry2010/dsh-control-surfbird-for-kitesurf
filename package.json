{
  "name": "dsh-control-surfbird-for-kitesurf",
  "version": "0.0.1",
  "description": "Control a Kitesurf browser engine over CDP from DSH via surfbird. Works with surfbird raw/auth deployments and upstream kitesurf.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "client",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "node --test test/unit/*.test.mjs",
    "test:live": "node --test test/live/*.test.mjs",
    "check": "node --input-type=module -e \"import('./src/index.ts').then(m => { if (typeof m.apply !== 'function') throw new Error('apply missing'); if (!m.name) throw new Error('name missing'); console.log('OK', m.name) })\""
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "kitesurf",
    "surfbird",
    "browser",
    "cdp",
    "automation"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/terry2010/dsh-control-surfbird-for-kitesurf.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.1-rc.1 <0.3.0",
    "@deepseek-ai/dsh-attachment": ">=0.1.1-rc.1 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.1.1-rc.1 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.1.1-rc.1 <0.3.0",
    "@deepseek-ai/dsh-util-values": ">=0.1.1-rc.1 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.3",
    "@deepseek-ai/dsh-attachment": "0.2.2-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.3",
    "@types/node": "^26.6.6",
    "@types/ws": "8.18.1",
    "typescript": "5.9"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "@mozilla/readability": "^0.6.0",
    "turndown": "^7.2.5",
    "ws": "~8.22.2",
    "yaml": "2.9.0"
  }
}
