{
  "name": "dsh-control-kitesurf",
  "version": "0.0.1",
  "description": "Control a Kitesurf browser engine over CDP from DSH. Works with surfbird raw/auth deployments and upstream kitesurf.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "node --test test/unit/*.test.mjs",
    "check": "node --input-type=module -e \"import('./src/index.ts').then(m => { if (typeof m.apply !== 'function') throw new Error('apply missing'); if (!m.name) throw new Error('name missing'); console.log('OK', m.name) })\""
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "kitesurf",
    "surfbird",
    "browser",
    "cdp",
    "automation"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/terry2010/dsh-control-kitesurf.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.1",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@types/node": "^26.6.6",
    "@types/ws": "8.18.1",
    "typescript": "5.9"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "turndown": "^7.2.5",
    "ws": "~8.22.2"
  }
}
